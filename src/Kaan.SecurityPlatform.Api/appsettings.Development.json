{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "Jwt": {
    "SigningKey": "kaan-dev-signing-key-please-override-with-user-secrets-2026"
  },
  "DomainVerification": {
    "EnableMockStrategy": true,
    "MockAutoApproveToken": "kaan-dev-approve"
  },
  "FindingValidation": {
    "AllowMockAuthorization": true,
    "DefaultMaxRequestCount": 10,
    "DelayBetweenRequestsMs": 350
  },
  "AuthenticatedScanning": {
    "MaxRequestsPerRun": 15,
    "DelayMs": 250,
    "EnablePlaywright": true,
    "HeadlessDefault": false,
    "MaxTestAccountsPerTarget": 2
  }
}
