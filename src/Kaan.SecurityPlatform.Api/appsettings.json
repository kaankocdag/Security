{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=KaanSecurityPlatform;Trusted_Connection=True;Encrypt=False;MultipleActiveResultSets=true",
    "Hangfire": ""
  },
  "Jwt": {
    "Issuer": "kaan-security-platform",
    "Audience": "kaan-security-platform-clients",
    "SigningKey": "REPLACE-WITH-USER-SECRETS-OR-ENV-VAR-AT-LEAST-32-CHARS",
    "AccessTokenLifetimeMinutes": 30,
    "RefreshTokenLifetimeDays": 14,
    "TokenType": "Bearer",
    "ClockSkewSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001"
    ]
  },
  "Lab": {
    "RuntimeMode": "Auto",
    "ElevationMinutes": 10,
    "ExecutionTimeoutMinutes": 15,
    "DockerEndpoint": "npipe://./pipe/docker_engine",
    "ImagePrefix": "kaan-lab/",
    "InternalNetworkName": "kaan-lab-net",
    "AllowEgress": true,
    "MaxHttpRequestsPerExecution": 40
  },
  "DomainVerification": {
    "TxtRecordPrefix": "_kaan-security",
    "HtmlFilePath": "/.well-known/kaan-security-verification.txt",
    "MetaTagName": "kaan-security-verification",
    "EnableMockStrategy": false,
    "TimeoutSeconds": 8
  },
  "Storage": {
    "RootPath": "storage",
    "PublicBaseUrl": "/storage"
  },
  "HackerOne": {
    "ApiEnabled": true,
    "BaseUrl": "https://api.hackerone.com/v1",
    "OpenReportUrlTemplate": "https://hackerone.com/{handle}",
    "MinReadinessScoreForSubmit": 70,
    "AmazonVrp": {
      "UserAgent": "KaanSecurityPlatform-AmazonVRP-Candidate/1.0 (+https://local.dev; research)",
      "RateLimitPerMinute": 20
    }
  },
  "FindingValidation": {
    "AllowMockAuthorization": false,
    "DefaultMaxRequestCount": 10,
    "DelayBetweenRequestsMs": 350,
    "MaxConcurrencyPerTarget": 1,
    "UserAgent": "Kaan.SecurityPlatform-FindingValidation/1.0 (+safe-research; read-only)"
  },
  "AuthenticatedScanning": {
    "MaxRequestsPerRun": 25,
    "DelayMs": 400,
    "EnablePlaywright": true,
    "HeadlessDefault": false,
    "MaxTestAccountsPerTarget": 2
  }
}
